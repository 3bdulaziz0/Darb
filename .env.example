# ── Darb environment ────────────────────────────────────────────────────────
#
# Copy this file to `.env` and fill in the value:
#
#     cp .env.example .env
#
# `.env` is gitignored. Never commit it, never paste the key into a chat, and
# never put it in a file under src/ or public/.
#
# ⚠️  DO NOT rename this to VITE_GEMINI_API_KEY.
#
# Vite inlines every variable that starts with VITE_ into the JavaScript it
# ships to the browser. A key with that prefix is not secret — it is published,
# readable by anyone who opens devtools, and will be scraped and billed to you.
#
# Without the prefix, this variable is only visible to the serverless functions
# in api/, which is exactly where the model is called from. That is also why
# WORKING-AGREEMENT.md says never to call Gemini from the browser.
# ────────────────────────────────────────────────────────────────────────────

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite, which works on a current key.
# Older ids such as gemini-2.5-flash are retired for new keys and return 404.
# The server names the model in every error, so a wrong id is obvious.
GEMINI_MODEL=

# Optional. Defaults to gemini-3.1-flash-tts-preview.
#
# ⚠️  This must be a speech model — one with -tts in its name. A text model
# accepts the request, answers, and returns no audio at all. Do NOT set this
# to the same value as GEMINI_MODEL.
#
# Narration is generated, so the key pays for audio as well as recognition.
GEMINI_TTS_MODEL=

# Optional. Below this confidence a match becomes a refusal. Defaults to 0.8.
# The PRD says to calibrate this against the held-out photo set on day 4;
# do not guess it earlier.
DARB_CONFIDENCE_THRESHOLD=
